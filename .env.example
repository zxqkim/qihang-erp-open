# ===== MySQL 8 =====
# root 密码，同时用于容器 healthcheck
MYSQL_ROOT_PASSWORD=QhErp@Root2026
# 初始化时自动创建的数据库名，需与 application.yml 库名一致
MYSQL_DATABASE=qihang-erp
# 应用使用的普通账号（erp-api 连接库用此账号）
MYSQL_USER=qherp
MYSQL_PASSWORD=QhErp@2026

# ===== Redis 7 =====
REDIS_PASSWORD=QhErp@Redis2026

# ===== 后端连接信息（compose 内部服务名） =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379

# ===== JWT =====
# 生产部署务必替换为随机长字符串（建议 64 位以上）
TOKEN_SECRET=abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkrstuvwxyzabcdefghijklmnopqrstuvwxyz
# Token 有效期（分钟）
TOKEN_EXPIRE_TIME=60

# ===== AI（可选）=====
# 留空则 AI 智能分析不可用，不影响其余功能
# 注意：不要留空，Spring AI 自动配置会因空值导致应用启动失败；
# 无 key 时保持 not-configured 即可（AI 功能不可用，其余功能正常）
DEEPSEEK_API_KEY=not-configured
